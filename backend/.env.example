# Copy this file to .env and fill in your own values. Never commit .env.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your website's URL(s)).
# Use * only for local testing.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- MySQL connection ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dental_app
DB_PASSWORD=change_this_password
DB_NAME=dr_deleep_dental
DB_CONNECTION_LIMIT=10

# --- Clinic ---
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=17:00
CLINIC_SLOT_MINUTES=30

# --- Admin dashboard auth ---
# Any request to /api/admin/* must send this value in the "x-admin-key" header.
# Generate a long random string, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=change_this_to_a_long_random_string
